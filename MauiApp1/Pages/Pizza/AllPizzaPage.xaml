<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MauiApp1.ViewModel"
             xmlns:models="clr-namespace:MauiApp1.Model"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="MauiApp1.Pages.Pizza.AllPizzaPage"
             x:DataType="vm:AllPizzaViewModel"
             Title="All Pizzas">
    
    <ContentPage.Triggers>
        <DataTrigger TargetType="ContentPage" 
                     Binding="{Binding FromSearch}" Value="True">
            <Setter Property="Title" Value="Search for pizza"></Setter>
        </DataTrigger>
    </ContentPage.Triggers>
    
    <Grid RowDefinitions="Auto,*">
        <SearchBar Grid.Row="0" x:Name="searchBar" 
                   Placeholder="Search for pizza" PlaceholderColor="Goldenrod" 
                   BackgroundColor="White" CancelButtonColor="Red"
                   TextColor="DarkGoldenrod"
                   ios:SearchBar.SearchBarStyle="Minimal" 
                   SearchCommand="{Binding SearchPizzasCommand}"
                   SearchCommandParameter="{Binding Source={x:Reference searchBar}, Path=Text}"
                   TextChanged="SearchBar_OnTextChanged"/>
        
        <ScrollView Grid.Row="1" Margin="5">
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding Pizzas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Pizza">
                            <Border StrokeShape="Rectangle 10" StrokeThickness="0" 
                                    BackgroundColor="PaleGoldenrod" Padding="10" Margin="5">
                                <Grid ColumnDefinitions="130, *">
                                    <Image Grid.Column="0" Source="{Binding Image}"
                                           HeightRequest="130" WidthRequest="130" />
                                    
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         Spacing="5">
                                        <Label Text="{Binding Name}" FontSize="30" />
                                        <Grid ColumnDefinitions="*, *">
                                            <Label Grid.Column="0" Text="{Binding Price, StringFormat='${0:N2}'}"
                                                   FontAttributes="Bold"/>
                                            
                                            <HorizontalStackLayout Grid.Column="1"
                                                                   HorizontalOptions="End"
                                                                   Spacing="2" VerticalOptions="Center">
                                                <Label Text="4" />
                                                <Image Source="star.png" HeightRequest="15" WidthRequest="15" >
                                                    <Image.Behaviors>
                                                        <toolkit:IconTintColorBehavior TintColor="DarkGoldenrod" />
                                                    </Image.Behaviors>
                                                </Image>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <Border StrokeShape="RoundRectangle 25" StrokeThickness="0" 
                                                BackgroundColor="Gold" HeightRequest="45" HorizontalOptions="Center"
                                                Padding="30,5" VerticalOptions="End">
                                            <HorizontalStackLayout Spacing="2" Padding="2">
                                                <Label Text="View more" VerticalOptions="Center"></Label>
                                                <Image Source="arrow_left.svg" HeightRequest="30" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type 
                                                vm:AllPizzaViewModel}}, Path=GoToDetailPageCommand}"
                                                                      CommandParameter="{Binding .}"></TapGestureRecognizer>
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <BoxView HeightRequest="100" Color="White"></BoxView>
                            <Label Text="No result found" FontSize="25" TextColor="Gray" HorizontalTextAlignment="Center" >
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Searching}"
                                                 Value="true">
                                        <Setter Property="Text" Value="Searching ..."></Setter>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        
        <ActivityIndicator Grid.RowSpan="2" 
                           IsRunning="{Binding Searching}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" Color="DarkGoldenrod" />
    </Grid>
    
</ContentPage>