<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="This is TestPage"
             x:Class="MauiApp1.TestPage">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">
            <Label Text="Enter a Phoneword" FontSize="20"/>

            <Entry x:Name="PhoneNumberText" Text="1-555-NETMAUI"/>
            
            <Switch IsToggled="true"  SemanticProperties.Description="Toggle setting" />
            <Switch OffColor="Red" OnColor="Orange" ThumbColor="Green" />

            <Button x:Name="TranslateButton" Text="Translate" Clicked="OnTranslate"/>

            <Button x:Name="CallButton" Text="Call" IsEnabled="False" Clicked="OnCall"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>